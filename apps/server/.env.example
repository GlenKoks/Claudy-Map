# Claudy Map server — environment variables
# Copy this file to `.env` and fill in real values.

# HTTP server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Telegram bot (create via @BotFather; set the login domain there too)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
# Reject Telegram auth payloads older than this many seconds (default: 86400)
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# OSRM routing engine (e.g. http://localhost:5000)
OSRM_URL=http://localhost:5000
