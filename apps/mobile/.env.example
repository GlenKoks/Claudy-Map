# Claudy Map mobile — public env vars (inlined into the JS bundle at build time).
# Copy to apps/mobile/.env and fill in values. All must be prefixed EXPO_PUBLIC_.

# Base URL of the Claudy Map server (Fastify). On a device use your machine's
# LAN IP or a public URL, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project (anon key is public/safe to ship).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram bot username (without @). Must match the bot whose domain is set in
# @BotFather to the server's public domain (/setdomain).
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Dev bypass login button. Defaults to enabled in development builds.
# Set to "false" to hide it.
EXPO_PUBLIC_ALLOW_DEV_LOGIN=true
