{
  "name": "claudy-map",
  "version": "0.0.0",
  "private": true,
  "description": "Claudy Map — a walking app where the city map is hidden under fog that clears as you walk.",
  "scripts": {
    "mobile": "pnpm --filter @claudy-map/mobile start",
    "server": "pnpm --filter @claudy-map/server dev",
    "server:build": "pnpm --filter @claudy-map/server build",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
